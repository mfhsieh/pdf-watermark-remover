{
  "name": "pdf-watermark-remover",
  "version": "2.3.5",
  "description": "PDF 浮水印清除工具，純前端執行，無伺服器上傳，保護您的隱私。",
  "main": "index.js",
  "directories": {
    "doc": "doc",
    "test": "test"
  },
  "scripts": {
    "e2e": "node test/e2e.mjs",
    "snap": "node test/snap.mjs",
    "lint": "eslint js/ test/ doc/",
    "format": "prettier --write \"js/**/*.js\" \"test/**/*.mjs\" \"doc/**/*.mjs\" \"css/**/*.css\" \"*.html\"",
    "docs": "node doc/doc-gen.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mfhsieh/pdf-watermark-remover.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mfhsieh/pdf-watermark-remover/issues"
  },
  "homepage": "https://github.com/mfhsieh/pdf-watermark-remover#readme",
  "devDependencies": {
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "jsdoc-to-markdown": "^9.1.3",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.8.3",
    "puppeteer-core": "^25.1.0",
    "text-encoding": "^0.7.0"
  }
